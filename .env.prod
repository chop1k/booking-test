# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Basic parameters
# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
APP_ENV=prod
APP_DEBUG=0

# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# SQL Database parameters
# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_VERSION=

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"

# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# Polling parameters
# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
POLLING_TELEGRAM_TOKEN=
POLLING_ACCESS_TOKEN=
POLLING_REGISTER_URL=
POLLING_HTTPS_PROXY=
POLLING_APP_URL=
