{% set app_urls = {
    home: '/web/home',
    rooms: '/web/rooms',
    business_rooms: '/business/rooms',
    business_bookings: '/business/bookings',
    user_avatar_template: '/integration/telegram/user-avatar/__ID__',
} %}

<!doctype html>
<html lang="ru" data-tg-scheme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}Бронирование переговорных{% endblock %}</title>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script>
        window.appUrls = {
            userAvatar: "{{ app_urls.user_avatar_template }}",
        };
    </script>

    {% block importmap %}
        {{ importmap('app') }}
    {% endblock %}

    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body
    data-controller="telegram{% block body_controllers %}{% endblock %}"
    {% block body_data %}{% endblock %}
>
    {% block body %}
        <main class="page">
            {% block content %}{% endblock %}
        </main>

        {% block overlays %}{% endblock %}
    {% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
