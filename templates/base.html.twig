<!doctype html>
<html lang="ru" data-tg-scheme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}Бронирование переговорных{% endblock %}</title>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    {% block importmap %}
        {{ importmap('app') }}
    {% endblock %}

    <style>
        {% block base_styles %}
            :root {
                --tg-bg-color: #ffffff;
                --tg-text-color: #0f0f0f;
                --tg-hint-color: #8b8b8f;
                --tg-link-color: #2481cc;
                --tg-button-color: #2481cc;
                --tg-button-text-color: #ffffff;
                --tg-secondary-bg-color: #f2f2f5;
                --tg-header-bg-color: #ffffff;
                --tg-accent-text-color: #2481cc;
                --tg-section-bg-color: #ffffff;
                --tg-section-header-text-color: #6d6d72;
                --tg-subtitle-text-color: #8b8b8f;
                --tg-destructive-text-color: #e0384b;

                --tg-viewport-stable-height: 100vh;

                --space-1: 4px;
                --space-2: 8px;
                --space-3: 12px;
                --space-4: 16px;
                --space-5: 24px;
                --space-6: 32px;

                --radius-l: 20px;
                --radius-m: 14px;
                --radius-s: 10px;

                --shadow-card: 0 1px 2px rgba(15, 15, 15, 0.06), 0 8px 24px rgba(15, 15, 15, 0.08);
            }

            html[data-tg-scheme="dark"] {
                --tg-bg-color: #17212b;
                --tg-text-color: #f0f0f0;
                --tg-hint-color: #7c8a9a;
                --tg-link-color: #6ab7ff;
                --tg-button-color: #5288c1;
                --tg-button-text-color: #ffffff;
                --tg-secondary-bg-color: #1f2a37;
                --tg-header-bg-color: #17212b;
                --tg-accent-text-color: #6ab7ff;
                --tg-section-bg-color: #1c2733;
                --tg-section-header-text-color: #6ab7ff;
                --tg-subtitle-text-color: #7c8a9a;
                --tg-destructive-text-color: #f0505f;
                --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.35);
            }

            * { box-sizing: border-box; }

            html, body {
                margin: 0;
                padding: 0;
                min-height: var(--tg-viewport-stable-height, 100vh);
                background: var(--tg-bg-color);
                color: var(--tg-text-color);
                font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                -webkit-tap-highlight-color: transparent;
            }

            body {
                opacity: 0;
                transition: opacity 0.2s ease;
            }
            body.is-ready { opacity: 1; }

            button { font-family: inherit; }

            :focus-visible {
                outline: 2px solid var(--tg-link-color);
                outline-offset: 2px;
            }

            .page {
                max-width: 560px;
                margin: 0 auto;
                padding: var(--space-4) var(--space-4) var(--space-6);
                display: flex;
                flex-direction: column;
                gap: var(--space-5);
            }

            .sheet-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0);
                transition: background 0.25s ease;
                z-index: 40;
            }
            .sheet-backdrop.is-visible { background: rgba(0, 0, 0, 0.4); }

            .sheet {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 50;
                max-width: 560px;
                margin: 0 auto;
                background: var(--tg-section-bg-color);
                border-radius: var(--radius-l) var(--radius-l) 0 0;
                box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.2);
                height: 60vh;
                display: flex;
                flex-direction: column;
                transform: translateY(100%);
                transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1), height 0.28s cubic-bezier(0.32, 0.72, 0, 1);
            }
            .sheet.is-dragging { transition: none; }
            .sheet.is-collapsed { transform: translateY(0); height: 60vh; }
            .sheet.is-expanded { transform: translateY(0); height: 94vh; }
            .sheet.is-closed { transform: translateY(100%); }

            .sheet__handle {
                padding: var(--space-2) 0;
                display: flex;
                justify-content: center;
                cursor: grab;
                touch-action: none;
            }
            .sheet__handle::before {
                content: '';
                width: 36px;
                height: 4px;
                border-radius: 2px;
                background: var(--tg-hint-color);
                opacity: 0.5;
            }

            .sheet__header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 var(--space-4) var(--space-3);
            }

            .sheet__title {
                margin: 0;
                font-size: 16px;
                font-weight: 700;
                text-transform: capitalize;
            }

            .sheet__close {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                border: none;
                background: var(--tg-secondary-bg-color);
                color: var(--tg-hint-color);
                font-size: 14px;
                cursor: pointer;
                flex-shrink: 0;
            }

            .sheet__body {
                flex: 1;
                overflow-y: auto;
                padding: 0 var(--space-4) var(--space-5);
            }

            @media (prefers-reduced-motion: reduce) {
                .sheet, .sheet-backdrop, body { transition: none !important; }
            }

            .page-header {
                display: flex;
                align-items: center;
                gap: var(--space-3);
                margin-bottom: var(--space-1);
            }

            .app-back {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: var(--tg-secondary-bg-color);
                color: var(--tg-text-color);
                text-decoration: none;
                font-size: 20px;
                line-height: 1;
                flex-shrink: 0;
            }
            .app-back:active { transform: scale(0.94); }

            .page-header__title {
                margin: 0;
                font-size: 20px;
                font-weight: 700;
                letter-spacing: -0.01em;
            }

            .schedule-list {
                display: flex;
                flex-direction: column;
            }

            .schedule-empty {
                color: var(--tg-hint-color);
                font-size: 14px;
                text-align: center;
                margin-top: var(--space-6);
            }

            .hour-item {
                border-bottom: 1px solid var(--tg-secondary-bg-color);
            }
            .hour-item__row {
                width: 100%;
                border: none;
                background: transparent;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: var(--space-3) 0;
                cursor: pointer;
                color: var(--tg-text-color);
            }
            .hour-item__time {
                font-size: 15px;
                font-variant-numeric: tabular-nums;
                font-weight: 600;
            }

            .hour-item__details {
                display: none;
                flex-direction: column;
                gap: var(--space-2);
                padding: 0 0 var(--space-3) var(--space-3);
                border-left: 2px solid var(--tg-secondary-bg-color);
                margin-left: var(--space-1);
            }
            .hour-item.is-open .hour-item__details { display: flex; }
            .hour-item.is-open .hour-item__row { padding-bottom: var(--space-2); }

            .minute-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 13px;
                color: var(--tg-hint-color);
            }
            .minute-item__time { font-variant-numeric: tabular-nums; }

            .avatars {
                display: flex;
                align-items: center;
            }
            .avatar {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                overflow: hidden;
                background: var(--tg-secondary-bg-color);
                border: 2px solid var(--tg-section-bg-color);
                margin-left: -8px;
                flex-shrink: 0;
            }
            .avatar:first-child { margin-left: 0; }
            .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
            .avatar--placeholder { background: var(--tg-hint-color); opacity: 0.4; }
            .avatar--more {
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
                color: var(--tg-button-text-color);
                background: var(--tg-hint-color);
            }
        {% endblock %}
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body
    data-controller="telegram{% block body_controllers %}{% endblock %}"
    {% block body_data %}{% endblock %}
>
    {% block body %}
        <main class="page">
            {% block content %}{% endblock %}
        </main>

        {% block overlays %}{% endblock %}
    {% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
