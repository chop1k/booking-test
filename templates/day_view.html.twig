{% extends 'base.html.twig' %}

{% block title %}Расписание дня{% endblock %}

{% block body_controllers %} day-view{% endblock %}

{% block body_data %}
    data-awaits-content-ready="true"
    data-day-view-date-value="{{ date is defined ? date|date('Y-m-d') : '' }}"
    data-day-view-bookings-url-value="/business/bookings"
{% endblock %}

{% block content %}
    <header class="page-header">
        {# TODO: заменить href="/" на {{ path('app_home') }}, когда роут будет назван #}
        <a class="app-back" href="/" aria-label="Назад">‹</a>
        <h2 class="page-header__title" data-day-view-target="dateLabel">Расписание дня</h2>
    </header>

    <div class="schedule-list" data-day-view-target="list">
        <p class="schedule-empty" data-day-view-target="empty">Загрузка расписания…</p>
    </div>
{% endblock %}
