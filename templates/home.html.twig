{% extends 'base.html.twig' %}

{% block title %}Бронирование переговорных{% endblock %}

{% block stylesheets %}
    <style>
        .booking-card__link {
            display: block;
            text-decoration: none;
            color: inherit;
            background: var(--tg-section-bg-color);
            border-radius: var(--radius-l);
            box-shadow: var(--shadow-card);
            overflow: hidden;
        }

        .collage {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            grid-template-rows: 1fr 1fr;
            aspect-ratio: 16 / 9;
            gap: 2px;
            background: var(--tg-secondary-bg-color);
        }

        .collage__slot {
            position: relative;
            overflow: hidden;
            background: var(--tg-secondary-bg-color);
        }
        .collage__slot img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .collage__slot--main { grid-row: 1 / 3; grid-column: 1; }
        .collage__slot--top { grid-row: 1; grid-column: 2; }
        .collage__slot--bottom { grid-row: 2; grid-column: 2; }

        .collage__slot--placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 600;
            color: var(--tg-hint-color);
        }

        .collage__error {
            grid-column: 1 / -1;
            grid-row: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tg-hint-color);
            font-size: 14px;
        }

        .booking-card__body {
            padding: var(--space-4) var(--space-5) var(--space-5);
            display: flex;
            flex-direction: column;
            gap: var(--space-1);
        }

        .booking-card__eyebrow {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--tg-accent-text-color);
        }

        .booking-card__title {
            margin: 0;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .booking-card__cta {
            margin-top: var(--space-2);
            font-size: 14px;
            font-weight: 600;
            color: var(--tg-link-color);
        }

        .schedule__title {
            margin: 0 0 var(--space-3);
            font-size: 17px;
            font-weight: 700;
        }

        .calendar {
            background: var(--tg-section-bg-color);
            border-radius: var(--radius-l);
            box-shadow: var(--shadow-card);
            padding: var(--space-4);
        }

        .calendar__switcher {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: var(--space-3);
        }

        .calendar__month {
            font-size: 15px;
            font-weight: 700;
            text-transform: capitalize;
        }

        .calendar__nav {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: var(--tg-secondary-bg-color);
            color: var(--tg-text-color);
            font-size: 18px;
            line-height: 1;
            cursor: pointer;
        }
        .calendar__nav:active { transform: scale(0.94); }

        .calendar__grid {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .calendar__grid th {
            font-size: 11px;
            font-weight: 600;
            color: var(--tg-hint-color);
            padding-bottom: var(--space-2);
            text-transform: uppercase;
        }
        .calendar__grid th.is-weekend { color: var(--tg-subtitle-text-color); opacity: 0.7; }

        .calendar__grid td {
            text-align: center;
            padding: 2px;
        }

        .calendar__day {
            width: 100%;
            aspect-ratio: 1;
            border: none;
            background: transparent;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            color: var(--tg-text-color);
            font-size: 14px;
            font-variant-numeric: tabular-nums;
        }
        .calendar__day:active { background: var(--tg-secondary-bg-color); }
        .calendar__day.is-weekend { color: var(--tg-subtitle-text-color); }
        .calendar__day.is-outside { opacity: 0.35; }
        .calendar__day.is-today .calendar__day-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--tg-link-color);
            color: var(--tg-button-text-color);
        }

        .calendar__density {
            width: 14px;
            height: 3px;
            border-radius: 2px;
            background: transparent;
        }
        .calendar__density--low { background: var(--tg-link-color); opacity: 0.4; }
        .calendar__density--medium { background: var(--tg-link-color); opacity: 0.75; }
        .calendar__density--high { background: var(--tg-link-color); opacity: 1; }

    </style>
{% endblock %}

{% block body_controllers %} room-booking-home{% endblock %}

{% block body_data %}
    data-awaits-content-ready="true"
    data-room-booking-home-rooms-url-value="/business/rooms"
{% endblock %}

{% block content %}
    <section class="booking-card">
        <a class="booking-card__link" href="/rooms" aria-label="Забронировать комнату — выбрать переговорную">
            <div class="collage" data-room-booking-home-target="collage"></div>
            <div class="booking-card__body">
                <span class="booking-card__eyebrow">Быстрое бронирование</span>
                <h2 class="booking-card__title">Забронировать комнату</h2>
                <span class="booking-card__cta">Выбрать переговорную →</span>
            </div>
        </a>
    </section>

    <section
        class="schedule"
        data-controller="calendar"
        data-calendar-bookings-url-value="/business/bookings"
    >
        <h3 class="schedule__title">Расписание бронирований</h3>

        <div class="calendar">
            <div class="calendar__switcher">
                <button type="button" class="calendar__nav" data-action="calendar#prevMonth" aria-label="Предыдущий месяц">‹</button>
                <span class="calendar__month" data-calendar-target="monthLabel"></span>
                <button type="button" class="calendar__nav" data-action="calendar#nextMonth" aria-label="Следующий месяц">›</button>
            </div>

            <table class="calendar__grid">
                <thead>
                    <tr>
                        {% for day in ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'] %}
                            <th class="{{ loop.index0 >= 5 ? 'is-weekend' : '' }}">{{ day }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody data-calendar-target="grid"></tbody>
            </table>
        </div>
    </section>
{% endblock %}

{% block overlays %}
    <div data-controller="day-schedule">
    <div class="sheet-backdrop" data-day-schedule-target="backdrop" data-action="click->day-schedule#close" hidden></div>
    <div
        class="sheet day-sheet"
        data-day-schedule-target="sheet"
        hidden
    >
        <div
            class="sheet__handle"
            data-action="touchstart->day-schedule#touchStart touchmove->day-schedule#touchMove touchend->day-schedule#touchEnd"
        ></div>
        <header class="sheet__header">
            <h4 class="sheet__title" data-day-schedule-target="dateLabel"></h4>
            <button type="button" class="sheet__close" data-action="day-schedule#close" aria-label="Закрыть">✕</button>
        </header>
        <div class="sheet__body schedule-list" data-day-schedule-target="list"></div>
    </div>
    </div>
{% endblock %}
