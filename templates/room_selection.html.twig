{% extends 'base.html.twig' %}

{% block title %}Выбор комнаты{% endblock %}

{% block stylesheets %}
    <style>
        .room-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: var(--space-4);
        }

        .room-list__empty {
            color: var(--tg-hint-color);
            font-size: 14px;
            text-align: center;
            margin-top: var(--space-6);
        }

        .room-card {
            background: var(--tg-section-bg-color);
            border-radius: var(--radius-l);
            box-shadow: var(--shadow-card);
            overflow: hidden;
        }

        .room-card__link {
            display: block;
            width: 100%;
            border: none;
            background: transparent;
            padding: 0;
            text-align: left;
            color: inherit;
            cursor: pointer;
            font: inherit;
        }

        .room-card__photo {
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            display: block;
            background: var(--tg-secondary-bg-color);
        }
        .room-card__photo--placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 600;
            color: var(--tg-hint-color);
        }

        .room-card__body {
            padding: var(--space-4);
            display: flex;
            flex-direction: column;
            gap: var(--space-1);
        }

        .room-card__name {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
        }

        .room-card__description {
            margin: 0;
            font-size: 14px;
            line-height: 1.4;
            color: var(--tg-hint-color);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .room-card__specs {
            margin-top: var(--space-2);
            display: flex;
            align-items: center;
            gap: var(--space-3);
        }

        .room-card__seats {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            min-width: 44px;
            font-size: 13px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            color: var(--tg-text-color);
        }
        .room-card__seats svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--tg-hint-color); }

        .room-card__equipment {
            display: flex;
            align-items: center;
            gap: var(--space-2);
        }

        .equip-icon {
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            background: var(--tg-secondary-bg-color);
            color: var(--tg-hint-color);
        }
        .equip-icon svg { width: 14px; height: 14px; }
        .equip-icon--present {
            background: color-mix(in srgb, var(--tg-link-color) 14%, transparent);
            color: var(--tg-link-color);
        }

        .booking-form {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
        }

        .booking-form__alert {
            padding: var(--space-3);
            border-radius: var(--radius-s);
            background: color-mix(in srgb, var(--tg-destructive-text-color) 12%, transparent);
            color: var(--tg-destructive-text-color);
            font-size: 13px;
        }

        .booking-form__field {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: var(--space-3);
            border-radius: var(--radius-m);
            background: var(--tg-secondary-bg-color);
            border: 1px solid transparent;
        }
        .booking-form__field--picker {
            width: 100%;
            text-align: left;
            cursor: pointer;
            font: inherit;
            color: inherit;
        }
        .booking-form__field.is-valid { border-color: #34c759; }
        .booking-form__field.is-invalid { border-color: var(--tg-destructive-text-color); }

        .booking-form__label {
            font-size: 12px;
            color: var(--tg-hint-color);
        }

        .booking-form__value {
            font-size: 15px;
            font-weight: 600;
        }

        .booking-form__input {
            border: none;
            background: transparent;
            font-size: 15px;
            font-weight: 600;
            color: var(--tg-text-color);
            padding: 0;
            font-family: inherit;
        }
        .booking-form__input:focus { outline: none; }

        .booking-form__equipment {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
        }

        .counter-field {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding: var(--space-2) var(--space-3);
            border-radius: var(--radius-m);
            background: var(--tg-secondary-bg-color);
        }

        .counter-field__icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--tg-section-bg-color);
            color: var(--tg-hint-color);
            flex-shrink: 0;
        }
        .counter-field__icon svg { width: 16px; height: 16px; }

        .counter-field__label {
            flex: 1;
            font-size: 14px;
        }

        .counter-field__control {
            display: flex;
            align-items: center;
            gap: var(--space-2);
        }

        .counter-field__btn {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: none;
            background: var(--tg-section-bg-color);
            color: var(--tg-text-color);
            font-size: 16px;
            line-height: 1;
            cursor: pointer;
        }
        .counter-field__btn:active { transform: scale(0.92); }
        .counter-field__btn:disabled { opacity: 0.35; cursor: default; }

        .counter-field__value {
            min-width: 20px;
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .booking-form__submit {
            margin-top: var(--space-2);
            border: none;
            border-radius: var(--radius-m);
            padding: 14px;
            background: var(--tg-button-color);
            color: var(--tg-button-text-color);
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-2);
        }
        .booking-form__submit:active { opacity: 0.85; }
        .booking-form__submit:disabled { opacity: 0.6; cursor: default; }

        .booking-form__spinner {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 2px solid color-mix(in srgb, var(--tg-button-text-color) 35%, transparent);
            border-top-color: var(--tg-button-text-color);
            animation: booking-form-spin 0.7s linear infinite;
        }

        @keyframes booking-form-spin {
            to { transform: rotate(360deg); }
        }

        @media (prefers-reduced-motion: reduce) {
            .booking-form__spinner { animation-duration: 1.4s; }
        }
    </style>
{% endblock %}

{% block body_controllers %} room-selection{% endblock %}

{% block body_data %}
    data-awaits-content-ready="true"
    data-room-selection-rooms-url-value="/business/rooms"
    data-room-selection-bookings-url-value="/business/bookings"
{% endblock %}

{% block content %}
    <header class="page-header">
        <a class="app-back" href="/" aria-label="Назад">‹</a>
        <h2 class="page-header__title">Выбор комнаты</h2>
    </header>

    <ul class="room-list" data-room-selection-target="list">
        <li class="room-list__empty" data-room-selection-target="empty">Загрузка комнат…</li>
    </ul>

    <template data-room-selection-target="cardTemplate">
        <li class="room-card">
            <button type="button" class="room-card__link" data-room-selection-target="cardLink" data-action="room-selection#openRoom">
                <img class="room-card__photo" data-room-selection-target="cardPhoto" alt="">
                <div class="room-card__body">
                    <h3 class="room-card__name" data-room-selection-target="cardName"></h3>
                    <p class="room-card__description" data-room-selection-target="cardDescription"></p>
                    <div class="room-card__specs">
                        <span class="room-card__seats" data-room-selection-target="cardSeats">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><use href="#icon-seats"></use></svg>
                            <span data-room-selection-target="cardSeatsValue"></span>
                        </span>
                        <div class="room-card__equipment" data-room-selection-target="cardEquipment"></div>
                    </div>
                </div>
            </button>
        </li>
    </template>

    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <defs>
            <symbol id="icon-seats" viewBox="0 0 24 24">
                <path d="M6 19v-3a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3M4 19h16M6 14V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6" stroke-linecap="round" stroke-linejoin="round"/>
            </symbol>
            <symbol id="icon-displays" viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="12" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8 21h8M12 17v4" stroke-linecap="round" stroke-linejoin="round"/>
            </symbol>
            <symbol id="icon-boards" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="13" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8 21h8M7 9l4 3 3-4 3 3" stroke-linecap="round" stroke-linejoin="round"/>
            </symbol>
            <symbol id="icon-air-conditioners" viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="6" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7 15v4M12 15v5M17 15v4" stroke-linecap="round" stroke-linejoin="round"/>
            </symbol>
            <symbol id="icon-office-attributes" viewBox="0 0 24 24">
                <path d="M7 3h10l1 4H6l1-4Z" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 12h6M9 16h6" stroke-linecap="round" stroke-linejoin="round"/>
            </symbol>
            <symbol id="icon-tables" viewBox="0 0 24 24">
                <path d="M3 9h18M6 9v11M18 9v11" stroke-linecap="round" stroke-linejoin="round"/>
            </symbol>
        </defs>
    </svg>
{% endblock %}

{% block overlays %}
    <div data-controller="booking-form">
    <div class="sheet-backdrop" data-booking-form-target="backdrop" data-action="click->booking-form#close" hidden></div>
    <div
        class="sheet"
        data-booking-form-target="sheet"
        hidden
    >
        <div
            class="sheet__handle"
            data-action="touchstart->booking-form#touchStart touchmove->booking-form#touchMove touchend->booking-form#touchEnd"
        ></div>
        <header class="sheet__header">
            <h4 class="sheet__title" data-booking-form-target="roomName"></h4>
            <button type="button" class="sheet__close" data-action="booking-form#close" aria-label="Закрыть">✕</button>
        </header>
        <div class="sheet__body">
            <form class="booking-form" data-booking-form-target="form" data-action="submit->booking-form#submit">
                <div class="booking-form__alert" data-booking-form-target="alert" hidden></div>

                <button
                    type="button"
                    class="booking-form__field booking-form__field--picker"
                    data-booking-form-target="startField"
                    data-action="booking-form#pickStart"
                >
                    <span class="booking-form__label">Начало бронирования</span>
                    <span class="booking-form__value" data-booking-form-target="startValue">Выбрать дату и время</span>
                </button>

                <button
                    type="button"
                    class="booking-form__field booking-form__field--picker"
                    data-booking-form-target="endField"
                    data-action="booking-form#pickEnd"
                >
                    <span class="booking-form__label">Окончание бронирования</span>
                    <span class="booking-form__value" data-booking-form-target="endValue">Выбрать дату и время</span>
                </button>

                <label class="booking-form__field">
                    <span class="booking-form__label">Ожидаемое количество людей</span>
                    <input
                        type="number"
                        min="1"
                        inputmode="numeric"
                        class="booking-form__input"
                        name="expected_people"
                        data-booking-form-target="peopleInput"
                    >
                </label>

                <div class="booking-form__equipment" data-booking-form-target="equipmentList"></div>

                {# Шаблон одного счётчика оборудования — клонируется на каждый пункт оборудования комнаты #}
                <template data-booking-form-target="counterTemplate">
                    <div class="counter-field">
                        <span class="counter-field__icon" data-booking-form-target="counterIcon"></span>
                        <span class="counter-field__label" data-booking-form-target="counterLabel"></span>
                        <div class="counter-field__control">
                            <button type="button" class="counter-field__btn" data-action="booking-form#decrement" aria-label="Меньше">−</button>
                            <span class="counter-field__value" data-booking-form-target="counterValue">0</span>
                            <button type="button" class="counter-field__btn" data-action="booking-form#increment" aria-label="Больше">+</button>
                        </div>
                    </div>
                </template>

                <button type="submit" class="booking-form__submit" data-booking-form-target="submit">
                    <span class="booking-form__submit-text" data-booking-form-target="submitText">Забронировать</span>
                    <span class="booking-form__spinner" data-booking-form-target="spinner" hidden></span>
                </button>
            </form>
        </div>
    </div>
    </div>
{% endblock %}
